{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "820px",
      "wideSize": "1152px"
    },
    "useRootPaddingAwareAlignments": true,
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "custom": true,
      "palette": [
        { "slug": "base", "color": "#ffffff", "name": "Base" },
        { "slug": "contrast", "color": "#2b3a31", "name": "Contrast" },
        { "slug": "primary", "color": "#2f7d4e", "name": "Green" },
        { "slug": "accent", "color": "#d69a3a", "name": "Gold" },
        { "slug": "brand-dark", "color": "#1f3229", "name": "Forest" },
        { "slug": "secondary", "color": "#eef4ef", "name": "Light green" },
        { "slug": "muted", "color": "#6b7a70", "name": "Muted" },
        { "slug": "border", "color": "#e2e8e4", "name": "Border" }
      ],
      "gradients": [
        {
          "slug": "forest-fade",
          "name": "Forest fade",
          "gradient": "linear-gradient(180deg, rgba(31,50,41,0.75) 0%, rgba(31,50,41,0.55) 100%)"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "Sans",
          "fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.875rem" },
        { "slug": "medium", "name": "Medium", "size": "1rem" },
        {
          "slug": "large",
          "name": "Large",
          "size": "1.25rem",
          "fluid": { "min": "1.125rem", "max": "1.375rem" }
        },
        {
          "slug": "x-large",
          "name": "Extra large",
          "size": "2rem",
          "fluid": { "min": "1.75rem", "max": "2.25rem" }
        },
        {
          "slug": "xx-large",
          "name": "Huge",
          "size": "3rem",
          "fluid": { "min": "2.25rem", "max": "3.25rem" }
        }
      ]
    },
    "spacing": {
      "units": ["px", "em", "rem", "vh", "vw", "%"],
      "spacingSizes": [
        { "slug": "20", "name": "1", "size": "0.5rem" },
        { "slug": "30", "name": "2", "size": "1rem" },
        { "slug": "40", "name": "3", "size": "1.75rem" },
        { "slug": "50", "name": "4", "size": "2.5rem" },
        { "slug": "60", "name": "5", "size": "4rem" },
        { "slug": "70", "name": "6", "size": "6rem" }
      ]
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.65"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": { "left": "1.5rem", "right": "1.5rem" }
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--primary)" },
        "typography": { "textDecoration": "underline" },
        ":hover": { "typography": { "textDecoration": "none" } }
      },
      "heading": {
        "typography": { "fontWeight": "700", "lineHeight": "1.15", "letterSpacing": "-0.01em" }
      },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--base)"
        },
        "typography": { "fontWeight": "600", "fontSize": "var(--wp--preset--font-size--small)" },
        "spacing": { "padding": { "top": "0.85rem", "bottom": "0.85rem", "left": "1.75rem", "right": "1.75rem" } },
        "border": { "radius": "6px" },
        ":hover": { "color": { "background": "#276742" } }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": { "fontWeight": "600", "fontSize": "var(--wp--preset--font-size--medium)" }
      },
      "core/navigation": {
        "typography": { "fontWeight": "500", "fontSize": "var(--wp--preset--font-size--small)" }
      },
      "core/post-title": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
      "core/separator": { "color": { "text": "var(--wp--preset--color--border)" } },
      "core/quote": {
        "border": { "left": { "color": "var(--wp--preset--color--accent)", "width": "4px", "style": "solid" } },
        "spacing": { "padding": { "left": "1.5rem" } }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-full-width", "title": "Full width page", "postTypes": ["page"] }
  ]
}
